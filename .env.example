# Application
APP_ENV=production
APP_BIND_ADDRESS=0.0.0.0:8080
PUBLIC_BASE_URL=https://share.example.com
ALLOWED_ORIGINS=https://share.example.com
LOG_LEVEL=info,clarity_server=info
# Ignore forwarding headers for direct deployments. The bundled Compose stack
# overrides this to one because Caddy is its single trusted proxy hop.
TRUSTED_PROXY_HOPS=0

# Rooms
DEFAULT_ROOM_TTL_SECONDS=7200
MAX_ROOM_TTL_SECONDS=28800
MAX_VIEWERS_HARD_LIMIT=10
MAX_PENDING_VIEWERS=16
PENDING_VIEWER_TTL_SECONDS=120
PRESENTER_RESUME_GRACE_SECONDS=60
VIEWER_RESUME_GRACE_SECONDS=60

# Generate independent values with: openssl rand -base64 48
ROOM_TOKEN_HMAC_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
RESUME_TOKEN_HMAC_KEY=REPLACE_WITH_ANOTHER_AT_LEAST_32_RANDOM_CHARACTERS

# WebSocket and signaling limits
WS_AUTH_TIMEOUT_SECONDS=10
WS_HEARTBEAT_INTERVAL_SECONDS=15
WS_HEARTBEAT_TIMEOUT_SECONDS=10
WS_MAX_MESSAGE_BYTES=262144
WS_OUTBOUND_QUEUE_CAPACITY=128
SDP_MAX_BYTES=131072
ICE_CANDIDATE_MAX_BYTES=4096

# Per-source or per-session requests per minute
ROOM_CREATION_RATE_LIMIT=10
JOIN_RATE_LIMIT=60
AUTH_RATE_LIMIT=10
SIGNAL_RATE_LIMIT=240

# TURN
TURN_HOST=turn.example.com
TURN_REALM=turn.example.com
TURN_SHARED_SECRET=REPLACE_WITH_ANOTHER_AT_LEAST_32_RANDOM_CHARACTERS
TURN_PORT=3478
TURNS_PORT=5349
TURN_CREDENTIAL_TTL_SECONDS=3600
TURN_EXTERNAL_IP=203.0.113.10
# Set to the VPS private address only when the public address is NAT-mapped.
TURN_PRIVATE_IP=
TURN_RELAY_MIN_PORT=49160
TURN_RELAY_MAX_PORT=49260
# Optional TURNS certificate paths inside the coturn container.
TURN_TLS_CERT_PATH=
TURN_TLS_KEY_PATH=

# Caddy
APP_DOMAIN=share.example.com
CADDY_EMAIL=admin@example.com
