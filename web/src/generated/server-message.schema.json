  ],
  "$defs": {
    "ErrorCode": {
      "type": "string",
      "enum": [
        "unsupported_protocol_version",
        "invalid_message",
        "authentication_required",
        "authentication_failed",
        "authorization_denied",
        "room_not_found",
        "room_full",
        "room_expired",
        "room_closed",
        "viewer_not_found",
        "viewer_not_approved",
        "pending_viewer_limit_reached",
        "invalid_destination",
        "invalid_capacity",
        "message_too_large",
        "rate_limited",
        "session_expired",
        "origin_rejected",
        "internal"
      ]
    },
    "IceConfiguration": {
      "type": "object",
      "properties": {
        "expiresAt": {
          "type": "string"
        },
        "iceServers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IceServer"
          }
        }
      },
      "required": [
        "expiresAt",
        "iceServers"
      ]
    },
    "IceServer": {
      "type": "object",
      "properties": {
        "credential": {
          "type": [
            "string",
            "null"
          ]
        },
        "urls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "username": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "urls"
      ]
    },
    "PeerRole": {
      "type": "string",
      "enum": [
        "presenter",
        "viewer"
      ]
    },
    "PeerSnapshot": {
      "type": "object",
      "properties": {
        "connected": {
          "type": "boolean"
        },
        "displayName": {
          "type": [
            "string",
            "null"
          ]
        },
        "joinedAt": {
          "type": "string"
        },
        "peerId": {
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/PeerRole"
        },
        "viewerState": {
          "anyOf": [
            {
              "$ref": "#/$defs/ViewerState"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "peerId",
        "role",
        "connected",
        "joinedAt"
      ]
    },
    "RoomAccessPolicy": {
      "type": "string",
      "enum": [
        "public",
        "approvalRequired"
      ]
    },
    "RoomLifecycle": {
      "type": "string",
      "enum": [
        "open",
        "closed",
        "expired"
      ]
    },
    "RoomSnapshot": {
      "type": "object",
      "properties": {
        "accessPolicy": {
          "$ref": "#/$defs/RoomAccessPolicy"
        },
        "approvedViewers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PeerSnapshot"
          }
        },
        "expiresAt": {
          "type": "string"
        },
        "lifecycle": {
          "$ref": "#/$defs/RoomLifecycle"
        },
        "maximumViewers": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "pendingViewers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PeerSnapshot"
          }
        },
        "presenterConnected": {
          "type": "boolean"
        },
        "roomId": {
          "type": "string"
        }
      },
      "required": [
        "roomId",
        "lifecycle",
        "accessPolicy",
        "maximumViewers",
        "expiresAt",
        "presenterConnected",
        "pendingViewers",
        "approvedViewers"
      ]
    },
    "ViewerState": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "disconnected",
        "rejected",
        "kicked"
      ]
    }
  }
}
