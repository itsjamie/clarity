{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreateRoomRequest",
  "type": "object",
  "properties": {
    "accessPolicy": {
      "anyOf": [
        {
          "$ref": "#/$defs/RoomAccessPolicy"
        },
        {
          "type": "null"
        }
      ]
    },
    "allowedFriendCodes": {
      "description": "Friend codes permitted to join. Required (and non-empty) when\n`access_policy` is `FriendsOnly`; ignored otherwise.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "expiresInSeconds": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "maximumViewers": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint8",
      "maximum": 255,
      "minimum": 0
    }
  },
  "$defs": {
    "RoomAccessPolicy": {
      "type": "string",
      "enum": [
        "public",
        "approvalRequired",
        "friendsOnly"
      ]
    }
  }
}
