{
  "name": "clarity-share-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:test": "cross-env VITE_ENABLE_SYNTHETIC_CAPTURE=true vite --mode test",
    "generate:validators": "node scripts/generate-validators.mjs",
    "assert:production": "node scripts/assert-production-build.mjs",
    "assert:dist": "node scripts/assert-production-dist.mjs",
    "build": "pnpm generate:validators && pnpm assert:production && pnpm typecheck && vite build && pnpm assert:dist",
    "build:test": "cross-env VITE_ENABLE_SYNTHETIC_CAPTURE=true pnpm typecheck && vite build --mode test",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.app.json --pretty false && tsc --noEmit -p tsconfig.node.json --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:running": "node scripts/smoke-running-app.mjs",
    "playwright": "playwright test",
    "playwright:relay": "cross-env CLARITY_FORCE_RELAY=true playwright test tests/relay.spec.ts"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@playwright/test": "^1.52.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.28.0",
    "eslint-import-resolver-typescript": "^4.3.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  },
  "packageManager": "pnpm@11.9.0"
}
